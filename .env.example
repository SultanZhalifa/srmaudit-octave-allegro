# ============================================================
# SRMAudit 2026 — Environment Variables (template)
# ------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
# Only VITE_-prefixed vars are exposed to the browser bundle.
#
# Leave the Supabase vars empty to run in LOCAL mode (IndexedDB).
# Fill them in to run in CLOUD mode (Supabase auth + database).
#
# NEVER put the Supabase `service_role` / `sb_secret_...` key here.
# Only the publishable (anon) key belongs in a browser app.
# ============================================================

# Supabase project URL, e.g. https://abcd1234.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable / anon key (sb_publishable_... or eyJ...)
VITE_SUPABASE_ANON_KEY=

# Optional branding overrides
VITE_APP_NAME=SRMAudit
VITE_APP_YEAR=2026
